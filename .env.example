# Example environment for the CRM backend - PLACEHOLDERS ONLY.
# Copy the variables you need into Render (backend service > Environment) or a
# local, uncommitted .env. Never commit real values.
# Only the email part is listed here; see README.md for the rest.

# ---- Email from each employee's own mailbox (docs/email-provider-migration.md) ----
# 32 random bytes, base64 - e.g. `openssl rand -base64 32` (SECRET; losing it forces every employee to reconnect)
EMAIL_TOKEN_ENCRYPTION_KEY=
# Only while rotating keys: the previous value of EMAIL_TOKEN_ENCRYPTION_KEY (SECRET)
# EMAIL_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Frontend Email Account page the browser returns to after connecting
EMAIL_OAUTH_RETURN_URL=https://your-frontend.example.com/email-account
# Google Cloud > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
# (SECRET)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.example.com/api/email-accounts/oauth/google/callback
# Microsoft Entra > App registrations > your app > Overview: "Application (client) ID"
MICROSOFT_CLIENT_ID=
# Certificates & secrets > New client secret > the VALUE (not the Secret ID); shown once (SECRET)
MICROSOFT_CLIENT_SECRET=
# Overview: "Directory (tenant) ID" for a single-tenant registration (recommended), or
# organizations / common - must match the registration's "Supported account types".
MICROSOFT_TENANT_ID=
# Must be byte-for-byte the Web redirect URI registered in Entra (docs/email-provider-migration.md section 4)
MICROSOFT_REDIRECT_URI=https://your-backend.example.com/api/email-accounts/oauth/microsoft/callback
# Optional (defaults shown)
# EMAIL_REQUIRE_EMPLOYEE_EMAIL_MATCH=true
# EMAIL_GOOGLE_DAILY_LIMIT=400
# EMAIL_MICROSOFT_DAILY_LIMIT=2000
# EMAIL_GOOGLE_PER_MINUTE=60
# EMAIL_MICROSOFT_PER_MINUTE=30
